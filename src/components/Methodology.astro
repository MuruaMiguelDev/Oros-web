---
import CallToAction from "./ui/CallToAction.astro";

// Detectar idioma según la URL
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

const moreInfoBtnText = isEnglish ? "Más info" : "Más info";
const mountainImage = "https://images.unsplash.com/photo-1783427091805-c6cc3baacf2d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxkcmFtYXRpYyUyMG1vdW50YWluJTIwc3VtbWl0JTIwZGFyayUyMGJsdWUlMjBnb2xkZW4lMjBsaWdodCUyMGFlcmlhbHxlbnwxfHx8fDE3OTAzMDkwMTR8MA&ixlib=rb-4.1.0&q=85&w=1080";

const kpis = [
  {
    value: "3.84x",
    label: "Return on Ad Spend",
    change: "▲ +42% vs last month",
  },
  {
    value: "$18.40",
    label: "Target Acquisition Cost",
    change: "▼ -34% Cost per Lead",
  },
  {
    value: "1,420",
    label: "Qualified Leads Generated",
    change: "▲ +185% this quarter",
  },
];
---

<section id="methodology" class="bg-[#F6F6F6] py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Encabezado -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-[#001F3F]">
        {isEnglish ? (
          <>How We Drive <span class="text-[#ff4a09]">Rapid Growth</span></>
        ) : (
          <>Así Garantizamos su <span class="text-[#ff4a09]">Avance Rápido</span></>
        )}
      </h2>
      <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
        {isEnglish ? (
          <>No wasted time or endless revisions. We take you from idea to launch as quickly as possible—building steady, predictable momentum for <strong>your brand</strong></>
        ) : (
          <>No perdemos tiempo. Nuestro modelo está diseñado para pasar de la idea al lanzamiento en el menor tiempo posible, garantizando que el <strong>ascenso de su marca</strong> sea firme y sostenido.</>
        )}
      </p>
    </div>

    <!-- Fases -->
    <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-8 methodology-grid">

      <!-- FASE I -->
      <article id="fase1" class="card-modal">
        <div class="card-summary">
          <div class="text-sm font-bold text-[#ff4a09] tracking-wider mb-2">
            {isEnglish ? "PHASE I: INITIAL PEAK" : "FASE I: CIMA RÁPIDA"}
          </div>
          <h3 class="text-2xl font-semibold text-[#001F3F] mb-4">
            {isEnglish ? "The Strategy" : "La Estrategia"}
          </h3>
          <p class="text-gray-600 leading-relaxed mb-6">
            {isEnglish ? (
              <>We define your brand positioning, <em>core messaging,</em> and the top 3 high-ROI marketing initiatives. <strong>Less fluff, more action</strong></>
            ) : (
              <>Definimos su posición, mensaje clave y los 3 primeros <em>shots</em> de marketing con el mayor potencial de retorno. <strong>Menos papel, más acción.</strong></>
            )}
          </p>
          <br><br>
          <a href="#fase1" class="btn-info" role="button" aria-label={isEnglish ? "Open Phase I information" : "Abrir más información de Fase I"}>{moreInfoBtnText}</a>
        </div>

        <!-- Pop-Up FASE I -->
        <div class="card-details">
          <a href="#methodology" class="close-btn" aria-label={isEnglish ? "Close" : "Cerrar"}>✕</a>

          <div class="relative overflow-hidden rounded-[24px] border border-[#334155] bg-[#0F172A] p-6 text-slate-100 shadow-[0_30px_100px_rgba(0,0,0,0.5)]">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_46%,rgba(30,41,59,0.72),transparent_46%)]"></div>
            <div class="technical-grid pointer-events-none absolute inset-0"></div>

            <header class="relative z-10 border-b border-[#334155]/70 pb-5 mb-6">
              <div class="flex items-center justify-between mb-3">
                <span class="rounded-full border border-[#38BDF8]/50 bg-[#0EA5E9]/15 px-3 py-1 text-[10px] font-bold tracking-[0.14em] text-[#7DD3FC] uppercase">Phase I</span>
                <div class="flex items-center gap-1.5 text-[#F59E0B]">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24"><path d="m2.5 18.5 6.6-10.2 3.3 4.9 3.4-5.4 5.7 10.7h-19Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7"/></svg>
                  <span class="text-[10px] font-bold tracking-[0.15em]">ÓROS</span>
                </div>
              </div>
              <p class="text-[10px] font-semibold tracking-[0.16em] text-slate-500 uppercase">Infrastructure Layer</p>
              <h1 class="text-2xl md:text-3xl font-semibold tracking-[-0.035em] text-white mt-1">
                Conversion & Tracking Infrastructure
              </h1>
              <p class="text-xs text-slate-400 mt-1">
                Precision data architecture built for measurable growth, complete event visibility, and reliable attribution.
              </p>
            </header>

            <div class="relative z-10 flex flex-col items-center gap-4 py-2">
              <p class="text-[10px] font-bold tracking-[0.18em] text-slate-500 uppercase">Data Destinations</p>
              <div class="w-full grid gap-3 max-w-md">
                <div class="node-card flex min-h-[72px] items-center gap-4 rounded-xl border border-[#334155] bg-[#1E293B]/95 px-4">
                  <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-[#F59E0B]/20 bg-[#0F172A] text-xs font-bold text-[#F59E0B]">MP</div>
                  <div>
                    <p class="text-[13px] font-semibold text-slate-100">Meta Pixel / CAPI</p>
                    <div class="mt-1 flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-[#22C55E]"></span><p class="text-[10px] text-slate-400">Advanced Matching Enabled</p></div>
                  </div>
                </div>

                <div class="node-card flex min-h-[72px] items-center gap-4 rounded-xl border border-[#334155] bg-[#1E293B]/95 px-4">
                  <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-[#F59E0B]/20 bg-[#0F172A] text-xs font-bold text-[#F59E0B]">G4</div>
                  <div>
                    <p class="text-[13px] font-semibold text-slate-100">Google Analytics 4</p>
                    <div class="mt-1 flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-[#22C55E]"></span><p class="text-[10px] text-slate-400">Custom Event Mapping</p></div>
                  </div>
                </div>

                <div class="node-card flex min-h-[72px] items-center gap-4 rounded-xl border border-[#334155] bg-[#1E293B]/95 px-4">
                  <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-[#F59E0B]/20 bg-[#0F172A] text-xs font-bold text-[#F59E0B]">CR</div>
                  <div>
                    <p class="text-[13px] font-semibold text-slate-100">CRM / Lead Auto-Sync</p>
                    <div class="mt-1 flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-[#22C55E]"></span><p class="text-[10px] text-slate-400">Instant Routing</p></div>
                  </div>
                </div>
              </div>

              <div class="mobile-flow-line h-10 w-px"></div>

              <div class="engine-glow relative flex h-[190px] w-[190px] flex-col items-center justify-center rounded-full border border-[#38BDF8]/60 bg-[#111d2f] text-center my-1">
                <div class="absolute inset-2.5 rounded-full border border-dashed border-[#38BDF8]/25"></div>
                <div class="mb-2 grid h-12 w-12 place-items-center rounded-xl border border-[#38BDF8]/30 bg-[#38BDF8]/10 text-[#38BDF8] shadow-[0_0_20px_rgba(56,189,248,0.18)]">
                  <svg class="h-8 w-8" fill="none" viewBox="0 0 48 48">
                    <path d="M14 17.5h-1.2a6.3 6.3 0 1 1 1.5-12.4A9.2 9.2 0 0 1 31.7 7a6 6 0 1 1 3.5 10.8H34" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                    <rect x="9" y="21" width="30" height="9" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
                    <rect x="9" y="34" width="30" height="9" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M15 25.5h.01M15 38.5h.01M20 25.5h11M20 38.5h11" stroke="currentColor" stroke-linecap="round" stroke-width="2.2"/>
                    <path d="M24 17.5V21" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/>
                  </svg>
                </div>
                <p class="max-w-[140px] text-sm leading-tight font-semibold text-white">Server-Side Data Engine</p>
                <p class="mt-0.5 text-[9px] text-slate-500">Stape / Meta CAPI Gateway</p>
                <div class="mt-2.5 flex items-center gap-1.5 rounded-full border border-[#22C55E]/25 bg-[#22C55E]/10 px-2.5 py-1">
                  <span class="status-dot h-1.5 w-1.5 rounded-full bg-[#22C55E]"></span>
                  <span class="text-[8px] font-bold text-[#86EFAC] uppercase">Active · 99.4% Match</span>
                </div>
              </div>

              <div class="mobile-flow-line h-10 w-px"></div>

              <p class="text-[10px] font-bold tracking-[0.18em] text-slate-500 uppercase">Traffic Sources</p>
              <div class="w-full grid gap-3 max-w-md">
                <div class="node-card flex min-h-[72px] items-center gap-4 rounded-xl border border-[#334155] bg-[#1E293B]/95 px-4">
                  <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-[#38BDF8]/20 bg-[#0F172A] text-[#38BDF8]">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 28 20"><path d="M2 17C4.7 3.2 8.3 2 11.1 7.4L14 13l2.9-5.6C19.7 2 23.3 3.2 26 17M2 17c2.5 1.8 5.1-.4 9.1-9.6M26 17c-2.5 1.8-5.1-.4-9.1-9.6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"/></svg>
                  </div>
                  <div><p class="text-[10px] font-medium text-slate-500">Meta Ads</p><p class="mt-0.5 text-[13px] font-semibold text-slate-100">Paid Social Traffic</p></div>
                </div>

                <div class="node-card flex min-h-[72px] items-center gap-4 rounded-xl border border-[#334155] bg-[#1E293B]/95 px-4">
                  <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-[#38BDF8]/20 bg-[#0F172A] text-[#38BDF8]">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg>
                  </div>
                  <div><p class="text-[10px] font-medium text-slate-500">Google Search</p><p class="mt-0.5 text-[13px] font-semibold text-slate-100">High-Intent Search</p></div>
                </div>

                <div class="node-card flex min-h-[72px] items-center gap-4 rounded-xl border border-[#334155] bg-[#1E293B]/95 px-4">
                  <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-[#38BDF8]/20 bg-[#0F172A] text-[#38BDF8]">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24"><path d="M9.5 14.5 14.5 9M7.3 17.8l-1.1 1.1a3.5 3.5 0 0 1-5-5l4-4a3.5 3.5 0 0 1 5 0M16.7 6.2l1.1-1.1a3.5 3.5 0 1 1 5 5l-4 4a3.5 3.5 0 0 1-5 0" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/></svg>
                  </div>
                  <div><p class="text-[10px] font-medium text-slate-500">Organic Content</p><p class="mt-0.5 text-[13px] font-semibold text-slate-100">Direct & Referral</p></div>
                </div>
              </div>

              <div class="mt-3 flex items-center gap-2 rounded-full border border-[#38BDF8]/25 bg-[#38BDF8]/10 px-3 py-1.5 text-[9px] font-bold tracking-[0.09em] text-[#7DD3FC] uppercase">
                <span class="status-dot h-1.5 w-1.5 rounded-full bg-[#38BDF8]"></span> Live vertical data stream
              </div>
            </div>

            <!-- Navegación Flotante -->
            <div class="sticky bottom-0 left-0 right-0 pt-4 pb-1 bg-[#0F172A]/95 backdrop-blur-md border-t border-[#334155]/60 flex justify-center gap-2 z-30">
              <a href="#fase1" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase bg-[#38BDF8] text-[#031521] shadow-[0_0_15px_rgba(56,189,248,0.3)]">
                I · INFRASTRUCTURE
              </a>
              <a href="#fase2" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase text-slate-400 hover:bg-[#1E293B] hover:text-white transition">
                II · CREATIVE STACK
              </a>
              <a href="#fase3" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase text-slate-400 hover:bg-[#1E293B] hover:text-white transition">
                III · ANALYTICS
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- FASE II -->
      <article id="fase2" class="card-modal">
        <div class="card-summary">
          <div class="text-sm font-bold text-[#ff4a09] tracking-wider mb-2">
            {isEnglish ? "PHASE II: RIDGE CROSSING" : "FASE II: LOMADA EN MOVIMIENTO"}
          </div>
          <h3 class="text-2xl font-semibold text-[#001F3F] mb-4">
            {isEnglish ? "Activation & Infrastructure" : "Activación y Construcción de Plataformas"}
          </h3>
          <p class="text-gray-600 leading-relaxed mb-6">
            {isEnglish ? (
              <>We build or optimize your website, establish your brand identity, and launch high-impact social assets—all driven by <strong>continuous testing</strong> and iteration</>
            ) : (
              <>Construimos o ajustamos su web. Lanzamos su nueva identidad y creamos los activos de alto impacto para sus redes sociales. Todo con mentalidad de <strong>testeo continuo</strong>.</>
            )}
          </p>

          <a href="#fase2" class="btn-info" role="button" aria-label={isEnglish ? "Open Phase II information" : "Abrir más información de Fase II"}>{moreInfoBtnText}</a>
        </div>

        <!-- Pop-Up FASE II -->
        <div class="card-details">
          <a href="#methodology" class="close-btn" aria-label={isEnglish ? "Close" : "Cerrar"}>✕</a>

          <div class="relative overflow-hidden rounded-[24px] border border-[#334155] bg-[#0F172A] p-6 text-slate-100 shadow-[0_30px_100px_rgba(0,0,0,0.5)]">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_38%,rgba(30,41,59,0.72),transparent_44%)]"></div>
            <div class="technical-grid pointer-events-none absolute inset-0"></div>

            <header class="relative z-10 border-b border-[#334155]/70 pb-5 mb-6">
              <div class="flex items-center justify-between mb-3">
                <span class="rounded-full border border-[#38BDF8]/50 bg-[#0EA5E9]/15 px-3 py-1 text-[10px] font-bold tracking-[0.14em] text-[#7DD3FC] uppercase">Phase II</span>
                <div class="flex items-center gap-1.5 text-[#F59E0B]">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24"><path d="m2.5 18.5 6.6-10.2 3.3 4.9 3.4-5.4 5.7 10.7h-19Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7"/></svg>
                  <span class="text-[10px] font-bold tracking-[0.15em]">ÓROS</span>
                </div>
              </div>
              <p class="text-[10px] font-semibold tracking-[0.16em] text-slate-500 uppercase">Creative Conversion Layer</p>
              <h1 class="text-2xl md:text-3xl font-semibold tracking-[-0.045em] text-white mt-1 leading-snug">
                Ad Creative & High-Converting Landing Page Stack
              </h1>
              <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                One seamless, high-performance user journey from the first creative impression to qualified conversion.
              </p>
            </header>

            <div class="relative z-10 flex flex-col items-center gap-4 py-2">
              <p class="text-[10px] font-bold tracking-[0.18em] text-slate-500 uppercase self-start w-full text-center">01 / Hook-Tested Creative</p>
              
              <article class="node-card w-full max-w-md overflow-hidden rounded-2xl border border-[#334155] bg-[#1E293B]">
                <div class="flex h-[52px] items-center justify-between border-b border-[#334155] bg-[#172033] px-4">
                  <div class="flex items-center gap-2.5">
                    <div class="grid h-8 w-8 place-items-center rounded-full border border-[#F59E0B]/40 bg-[#F59E0B]/10 text-[#F59E0B]">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24"><path d="m2.5 18.5 6.6-10.2 3.3 4.9 3.4-5.4 5.7 10.7h-19Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7"/></svg>
                    </div>
                    <div>
                      <p class="text-xs font-semibold text-white">@oros.sm</p>
                      <p class="text-[9px] text-slate-500">Sponsored</p>
                    </div>
                  </div>
                  <div class="flex gap-1 text-slate-500">
                    <span class="h-1 w-1 rounded-full bg-current"></span>
                    <span class="h-1 w-1 rounded-full bg-current"></span>
                    <span class="h-1 w-1 rounded-full bg-current"></span>
                  </div>
                </div>

                <div class="relative aspect-[4/4.25] w-full overflow-hidden">
                  <img alt="Summit mountain view" class="h-full w-full object-cover" src={mountainImage} />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#050a12] via-[#0F172A]/15 to-transparent"></div>
                  <div class="absolute left-4 top-4 rounded-full border border-white/20 bg-black/25 px-2.5 py-1 text-[8px] font-bold tracking-[0.15em] text-white backdrop-blur-md uppercase">
                    The cost of guessing
                  </div>
                  <div class="absolute inset-x-4 bottom-5">
                    <h2 class="text-2xl font-bold tracking-[-0.055em] text-white leading-tight">
                      Stop Wasting<br />Ad Spend.<br />
                      <span class="text-[#38BDF8]">Scale With Data.</span>
                    </h2>
                    <p class="mt-2 text-[10px] text-slate-300">Turn every click into a clear signal for growth.</p>
                  </div>
                </div>

                <div class="flex h-[56px] items-center justify-between bg-[#172033] px-4 border-t border-[#334155]">
                  <span class="text-[9px] text-slate-400">Build your growth system</span>
                  <button class="flex items-center gap-1.5 rounded-lg bg-[#F59E0B] px-3 py-2 text-[10px] font-bold text-[#111827]" type="button">
                    Learn More →
                  </button>
                </div>
              </article>

              <div class="mobile-callout-connector mx-auto h-8 w-px"></div>

              <aside class="glass-callout w-full max-w-md rounded-xl border border-[#38BDF8]/25 p-4">
                <div class="mb-2 flex items-center justify-between">
                  <span class="rounded bg-[#38BDF8]/10 px-2 py-0.5 text-[8px] font-bold tracking-[0.1em] text-[#38BDF8] uppercase">Creative Signal</span>
                  <span class="text-[9px] font-bold text-[#22C55E]">A/B · 04</span>
                </div>
                <p class="text-xs font-semibold text-white">Hook-Tested Creative Angle</p>
                <p class="mt-1 text-[10px] leading-relaxed text-slate-400">Connected directly to the creative hook above—built to arrest attention and qualify intent.</p>
              </aside>

              <p class="text-[10px] font-bold tracking-[0.18em] text-slate-500 uppercase mt-4 text-center">02 / Conversion Experience</p>

              <div class="w-full max-w-md rounded-[32px] border border-[#475569] bg-[#060a12] p-2 shadow-[0_30px_65px_rgba(0,0,0,0.5),0_0_45px_rgba(56,189,248,0.07)]">
                <div class="relative min-h-[460px] overflow-hidden rounded-[24px] bg-[#F8FAFC] text-[#0F172A] p-5">
                  <div class="absolute left-1/2 top-2 h-4 w-16 -translate-x-1/2 rounded-full bg-[#05070b]"></div>
                  
                  <nav class="flex items-center justify-between border-b border-slate-200 pb-3 pt-2">
                    <div class="flex items-center gap-1.5 font-bold">
                      <svg class="h-4 w-4 text-[#F59E0B]" fill="none" viewBox="0 0 24 24"><path d="m2.5 18.5 6.6-10.2 3.3 4.9 3.4-5.4 5.7 10.7h-19Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7"/></svg>
                      <span class="text-[10px] tracking-[0.08em]">ÓROS</span>
                    </div>
                    <span class="text-[7px] font-semibold tracking-[0.12em] text-slate-400 uppercase">Growth Studio</span>
                  </nav>

                  <div class="pt-5">
                    <div class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-2.5 py-1 text-[7px] font-bold tracking-[0.08em] text-sky-600 uppercase">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#22C55E]"></span> Applications now open
                    </div>
                    <h2 class="text-xl font-bold tracking-[-0.055em] text-[#0F172A] leading-tight">Predictable Growth for Ambitious Brands</h2>
                    <p class="mt-2 text-[10px] text-slate-500 leading-relaxed">A data-led growth system built to turn attention into revenue.</p>
                    
                    <form class="mt-4 space-y-2.5" onclick="event.preventDefault();">
                      <input aria-label="Your name" class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-[10px] outline-none placeholder:text-slate-400" placeholder="Enter Your Name" type="text" />
                      <input aria-label="Email address" class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-[10px] outline-none placeholder:text-slate-400" placeholder="Enter Email" type="email" />
                      <button class="flex h-10 w-full items-center justify-center gap-1.5 rounded-lg bg-[#38BDF8] text-[9px] font-extrabold tracking-[0.06em] text-[#082F49] shadow-[0_8px_25px_rgba(56,189,248,0.3)]" type="button">
                        CLAIM STRATEGY CALL →
                      </button>
                    </form>

                    <div class="mt-4 flex items-center justify-center gap-3 text-[8px] font-medium text-emerald-600">
                      <span>✓ No obligation</span>
                      <span>✓ 100% private</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="mobile-callout-connector mx-auto h-8 w-px"></div>

              <aside class="glass-callout w-full max-w-md rounded-xl border border-[#38BDF8]/25 p-4">
                <div class="mb-2 flex items-center justify-between">
                  <span class="rounded bg-[#38BDF8]/10 px-2 py-0.5 text-[8px] font-bold tracking-[0.1em] text-[#38BDF8] uppercase">Experience Signal</span>
                  <span class="flex items-center gap-1 text-[9px] font-bold text-[#22C55E]">
                    <span class="status-dot h-1.5 w-1.5 rounded-full bg-[#22C55E]"></span> LIVE
                  </span>
