<!-- Script para disparar la animación al scrollear hasta la tarjeta del gráfico dentro del modal -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const chartContainer = document.getElementById('chart-container');
    const modalFase3 = document.querySelector('#fase3 .card-details');

    if (chartContainer && modalFase3) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              chartContainer.classList.add('is-visible');
            } else {
              // Si sale del scroll, reiniciamos la clase para que pueda repetirse la animación
              chartContainer.classList.remove('is-visible');
            }
          });
        },
        {
          root: modalFase3, // El contenedor con scroll es el modal expandido
          threshold: 0.35, // Se activa cuando el 35% del gráfico es visible
        }
      );

      observer.observe(chartContainer);
    }
  });
</script>

