---
const { pathname } = Astro.url;

// Detectar si la ruta actual es en inglés
const isEnglish = pathname.startsWith('/en/') || pathname === '/en';

// Mapeo de equivalencias entre rutas en Español e Inglés
const routesMap: Record<string, string> = {
  "/": "/en",
  "/servicios": "/en/services",
  "/contacto": "/en/contact",
  "/about": "/en/about",
  "/blog": "/en/blog",
  "/en": "/",
  "/en/services": "/servicios",
  "/en/contact": "/contacto",
  "/en/about": "/about",
  "/en/blog": "/blog",
};

// Normalizar la ruta eliminando barras inclinadas al final si las hubiera
const cleanPath = pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;

// Calcular la ruta destino al alternar según el mapa o fallback
let targetPath = routesMap[cleanPath] || (
  isEnglish
    ? (cleanPath.replace(/^\/en(\/|$)/, '/') || '/')
    : `/en${cleanPath}`
);
---

<a
  id="languagePickerToggle"
  href={targetPath}
  class="relative inline-flex h-8 w-20 cursor-pointer items-center rounded-full bg-slate-300/80 p-1 shadow-inner border border-slate-300/80 transition-colors duration-300 dark:bg-slate-800 dark:border-slate-700"
  aria-label={isEnglish ? "Switch to Spanish" : "Switch to English"}
  title={isEnglish ? "Cambiar a Español" : "Switch to English"}
>
  <!-- Texto de fondo inactivo -->
  <div class="flex w-full items-center justify-between px-2.5 pointer-events-none select-none text-[11px] font-bold tracking-wider text-slate-500">
    <span>Es</span>
    <span>En</span>
  </div>

  <!-- Botón deslizante con sigla activa integrada -->
  <span
    id="languagePickerPill"
    class={`absolute left-1 top-1 flex h-6 w-8 items-center justify-center rounded-full bg-white text-[11px] font-bold text-[#001F3F] shadow-md border border-slate-200/80 transition-transform duration-300 ease-in-out dark:bg-slate-900 dark:text-white dark:border-slate-600 ${
      isEnglish ? 'translate-x-10' : 'translate-x-0'
    }`}
  >
    {isEnglish ? 'En' : 'Es'}
  </span>
</a>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const toggle = document.getElementById("languagePickerToggle");
    const pill = document.getElementById("languagePickerPill");

    if (toggle && pill) {
      toggle.addEventListener("click", (e) => {
        e.preventDefault();
        const targetUrl = toggle.getAttribute("href");

        // Alternar animación
        pill.classList.toggle("translate-x-10");
        pill.classList.toggle("translate-x-0");

        setTimeout(() => {
          if (window.Astro && window.Astro.navigate) {
            window.Astro.navigate(targetUrl);
          } else {
            window.location.href = targetUrl;
          }
        }, 200);
      });
    }
  });
</script>