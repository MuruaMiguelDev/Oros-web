---
import AnnouncementBar from "./AnnouncementBar.astro";

const { pathname } = Astro.url;
const isEnglish = pathname.startsWith('/en/') || pathname === '/en';

const langPrefix = isEnglish ? '/en' : '';

const navItems = isEnglish
  ? [
      { label: "Home", path: "/" },
      { label: "Services", path: "/services" },
      { label: "About Us", path: "/about" },
      { label: "Contact", path: "/contact" },
      // { label: "Blog", path: "/blog" },
    ]
  : [
      { label: "Inicio", path: "/" },
      { label: "Servicios", path: "/servicios" },
      { label: "Nosotros", path: "/about" },
      { label: "Contacto", path: "/contacto" },
      //{ label: "Blogs", path: "/blog" },
    ];

const ctaText = isEnglish ? "Get a Free Quote" : "Solicitar Propuesta";
const homeUrl = isEnglish ? "/en" : "/";
const contactPath = isEnglish ? "/contact" : "/contacto";
const ctaHref = `${langPrefix}${contactPath}`;
---

<header class="bg-[#0a2540] shadow">
  <AnnouncementBar />

  <div class="bg-white px-4 md:px-6 py-3">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <!-- Logo -->
      <a href={homeUrl} class="flex items-center gap-2 p-2 rounded-2xl">
        <img src="/Logotipo-Navy---Navy-y-Coral.webp" alt="Logo Intellecta" class="h-8 w-auto" />
      </a>

      <!-- Botón mobile (Hamburguesa / X dinámico) -->
      <button
        id="mobileMenuBtn"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-[#0a2540] hover:bg-slate-100 transition-colors md:hidden"
        aria-controls="mobileMenu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <!-- Ícono Hamburguesa (Menú Cerrado) -->
        <svg
          id="hamburgerIcon"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>

        <!-- Ícono X (Menú Abierto) -->
        <svg
          id="closeIcon"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Nav escritorio -->
      <nav class="hidden md:flex md:items-center md:space-x-8">
        {
          navItems.map((item) => {
            const href = item.path === "/" ? (isEnglish ? "/en" : "/") : `${langPrefix}${item.path}`;
            return (
              <a
                href={href}
                class="group relative font-medium text-[#303133] transition-colors duration-200"
              >
                {item.label}
                <span class="absolute left-0 -bottom-1 h-[2px] w-0 bg-[#FF7F50] transition-all duration-300 group-hover:w-full" />
              </a>
            );
          })
        }
      </nav>

      <!-- CTA Escritorio -->
      <a
        href={ctaHref}
        class="hidden md:inline-flex items-center justify-center rounded-full bg-[#303133] px-4 py-2 font-medium text-white hover:bg-[#FF7F50] hover:text-[#f7f5f4] transition-colors duration-200"
      >
        {ctaText}
      </a>
    </div>
  </div>

  <!-- Overlay + Panel Mobile -->
  <div
    id="mobileOverlay"
    class="fixed inset-0 z-40 hidden bg-black/40 backdrop-blur-[1px]"
  >
  </div>

  <div
    id="mobileMenu"
    class="fixed inset-y-0 right-0 z-50 w-80 max-w-[85%] translate-x-full bg-white shadow-xl transition-transform duration-300 md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú"
  >
    <div class="flex items-center justify-between border-b px-4 py-3">
      <span class="text-sm font-semibold text-[#303133]">{isEnglish ? "Menu" : "Menú"}</span>
      <button
        id="mobileCloseBtn"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-[#303133] hover:bg-slate-100 transition-colors"
        aria-label="Cerrar menú"
      >
        <!-- Ícono X dentro del panel -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="px-4 py-4 space-y-1">
      {
        navItems.map((item) => {
          const href = item.path === "/" ? (isEnglish ? "/en" : "/") : `${langPrefix}${item.path}`;
          return (
            <a
              href={href}
              class="block rounded-lg px-3 py-2 text-base font-medium text-[#303133] hover:bg-[#FF7F50]/10"
            >
              {item.label}
            </a>
          );
        })
      }

      <a
        href={ctaHref}
        class="mt-3 inline-flex w-full items-center justify-center rounded-full bg-[#303133] px-4 py-2 font-medium transition-colors duration-200 text-white hover:text-[#FF7F50]"
      >
        {ctaText}
      </a>
    </nav>
  </div>

  <script is:inline>
    function setupMobileMenu() {
      const btn = document.getElementById("mobileMenuBtn");
      const panel = document.getElementById("mobileMenu");
      const overlay = document.getElementById("mobileOverlay");
      const closeBtn = document.getElementById("mobileCloseBtn");
      const hamburgerIcon = document.getElementById("hamburgerIcon");
      const closeIcon = document.getElementById("closeIcon");

      if (!btn || !panel) return;

      document.body.style.overflow = "";

      const open = () => {
        panel.classList.remove("translate-x-full");
        overlay?.classList.remove("hidden");
        hamburgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      };

      const close = () => {
        panel.classList.add("translate-x-full");
        overlay?.classList.add("hidden");
        closeIcon?.classList.add("hidden");
        hamburgerIcon?.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      };

      btn.addEventListener("click", () => {
        const isExpanded = btn.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          close();
        } else {
          open();
        }
      });

      overlay?.addEventListener("click", close);
      closeBtn?.addEventListener("click", close);

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    }

    document.addEventListener("astro:page-load", setupMobileMenu);
  </script>
</header>