---
// src/components/Hero.astro
interface Props {
  title?: string;
  subtitle?: string;
  ctaPrimaryText?: string;
  ctaPrimaryHref?: string;
  ctaSecondaryText?: string;
  ctaSecondaryHref?: string;
}

// Detectar idioma según la URL
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

// Textos por defecto según el idioma
const defaultTitle = isEnglish
  ? "Take Your Brand to New Heights"
  : "El Gran Ascenso Digital Para Tu Marca Comienza Hoy.";

const defaultSubtitle = isEnglish
  ? "We build high-impact growth engines for ambitious brands. From custom multichannel campaigns to social media scaling, we turn digital strategy into measurable results"
  : "Somos el motor de crecimiento que estas buscando. Diseñamos la estrategia multicanal perfecta para que escales posiciones en redes y en todas partes. Es hora de ejecutar y ver los resultados.";

const defaultCtaPrimaryText = isEnglish ? "Get a Free Quote" : "Solicitar Propuesta";
const defaultCtaPrimaryHref = isEnglish ? "/en/contact" : "/contacto";

const defaultCtaSecondaryText = isEnglish ? "Explore Services" : "Ver servicios";
const defaultCtaSecondaryHref = isEnglish ? "/en/services" : "/servicios";

const badgeText = isEnglish ? "Elevate Your Brand" : "Elevá tu marca con nosotros";
const startText = isEnglish ? "Start the Ascent Now" : "Iniciar el Ascenso Ahora:";
const guaranteeText = isEnglish ? "No long-term contracts. Full strategy ownership." : "Garantia de resultados y satisfacción";

const {
  title = defaultTitle,
  subtitle = defaultSubtitle,
  ctaPrimaryText = defaultCtaPrimaryText,
  ctaPrimaryHref = defaultCtaPrimaryHref,
  ctaSecondaryText = defaultCtaSecondaryText,
  ctaSecondaryHref = defaultCtaSecondaryHref,
} = Astro.props as Props;
---

<section
  class="relative overflow-hidden
  before:absolute before:inset-0 before:bg-[url('/silueta-cordillera.webp')]
  before:bg-bottom before:bg-cover before:opacity-5 before:mix-blend-multiply before:pointer-events-none"
>

  <div class="mx-auto max-w-7xl px-6 py-16 md:py-12 lg:px-8">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <!-- Columna izquierda: texto -->
      <div class="max-w-xl">
        <!-- badge -->
        <div class="inline-flex items-center gap-2 py-1 text-xs md:text-2xl font-medium text-[#303133]">
          <span class="inline-block h-4 w-4 rounded-full bg-[#ff4a09]"></span>
          {badgeText}
        </div>

        <h1 class="text-4xl font-bold leading-tight tracking-tight text-[#001F3F] md:text-6xl">
          {title}
        </h1>

        <p class="mt-4 text-[#303133]/70">
          {subtitle}
        </p>

        <div class="mt-6 ml-2 text-sm text-[#ff4a09]/80 font-semibold">
          {startText}
        </div>

        <!-- CTAs -->
        <div class="mt-4 md:mt-2 flex flex-wrap items-center gap-2 md:gap-4">
          <a
            href={ctaPrimaryHref}
            class="inline-flex items-center text-white hover:bg-[#FF7F50] hover:text-[#fdfdfd] rounded-full bg-[#303133] px-5 py-3 text-sm shadow-lg shadow-[#0a2540]/10 transition hover:translate-y-[-1px] hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ff4a09]"
          >
            {ctaPrimaryText}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>

          <a
            href={ctaSecondaryHref}
            class="inline-flex items-center underline underline-offset-4 hover:text-[#ff4a09] gap-2 px-5 py-3 text-sm text-[#303133] transition hover:translate-y-[-1px]"
          >
            {ctaSecondaryText}
          </a>
        </div>

        <!-- sello decorativo -->
        <div class="mt-10 inline-flex items-center gap-2 text-xs text-[#303133]/60">
          <span class="relative grid place-content-center">
            <span class="absolute h-8 w-8 rounded-full bg-[#ff4a09]/20 blur-[6px]"></span>
            <span class="h-5 w-5 rounded-full border-2 border-dashed border-[#001F3F]"></span>
          </span>

          {guaranteeText}
        </div>
      </div>

      <!-- Columna derecha: imagen única de mkt6.webp -->
      <div class="relative flex justify-center items-center">
        <!-- resplandor decorativo de fondo -->
        <div class="pointer-events-none absolute h-64 w-64 rounded-full bg-[#ff4a09]/20 blur-3xl"></div>

        <div class="relative w-full max-w-lg transition-transform duration-300 hover:scale-[1.02]">
          <img
            src="/mkt6.webp"
            alt="Análisis y resultados de marketing Óros SM"
            loading="eager"
            class="w-full h-auto object-contain drop-shadow-xl"
          />
        </div>
      </div>
    </div>
  </div>
</section>