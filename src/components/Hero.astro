---
// src/components/Hero.astro
interface Props {
  title?: string;
  titleHighlight?: string;
  titleEnd?: string;
  subtitle?: string;
  ctaPrimaryText?: string;
  ctaPrimaryHref?: string;
  ctaSecondaryText?: string;
  ctaSecondaryHref?: string;
}

// Detectar idioma según la URL
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

// Textos por defecto según el idioma
const defaultBadgeText = isEnglish ? "ELEVATE YOUR BRAND" : "ELEVÁ TU MARCA";

const defaultTitleStart = isEnglish ? "Take " : "El Gran Ascenso ";
const defaultTitleHighlight = isEnglish ? "Your Brand" : "de Tu Marca";
const defaultTitleEnd = isEnglish ? " to New Heights" : " Comienza Hoy";

const defaultCtaPrimaryText = isEnglish ? "Get a Free Quote" : "Solicitar Propuesta";
const defaultCtaPrimaryHref = isEnglish ? "/en/contact" : "/contacto";

const defaultCtaSecondaryText = isEnglish ? "Explore Services" : "Ver servicios";
const defaultCtaSecondaryHref = isEnglish ? "/en/services" : "/servicios";

const guaranteeText = isEnglish ? "No long-term contracts. Full strategy ownership." : "Sin contratos a largo plazo. Control total de la estrategia.";

const {
  ctaPrimaryText = defaultCtaPrimaryText,
  ctaPrimaryHref = defaultCtaPrimaryHref,
  ctaSecondaryText = defaultCtaSecondaryText,
  ctaSecondaryHref = defaultCtaSecondaryHref,
} = Astro.props as Props;
---

<section
  class="relative overflow-hidden bg-[#FAFAFA] py-12 md:py-20
  before:absolute before:inset-0 before:bg-[url('/silueta-cordillera.webp')]
  before:bg-bottom before:bg-cover before:opacity-5 before:mix-blend-multiply before:pointer-events-none"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- ESTRUCTURA PRINCIPAL -->
    <div class="flex flex-col md:grid md:grid-cols-2 md:items-center md:gap-12 lg:gap-16">
      
      <!-- 1. BLOQUE DE TEXTO SUPERIOR -->
      <div class="flex flex-col items-center text-center md:items-start md:text-left">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-1.5 text-[11px] md:text-xs font-bold tracking-widest text-[#ff4a09] uppercase mb-3">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#ff4a09]"></span>
          {defaultBadgeText}
        </div>

        <!-- Título principal -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold leading-[1.15] tracking-tight text-[#001F3F]">
          {defaultTitleStart}<span class="text-[#ff4a09]">{defaultTitleHighlight}</span>{defaultTitleEnd}
        </h1>

        <!-- Subtítulo / Descripción -->
        <p class="mt-4 text-xs sm:text-sm md:text-base leading-relaxed text-slate-600 max-w-lg">
          {isEnglish ? (
            <>We build high-impact growth engines for <strong>ambitious brands</strong>. From custom multichannel campaigns to social media scaling, we <strong>turn digital strategy into measurable results</strong>.</>
          ) : (
            <>Somos el motor de crecimiento que estás buscando para <strong>marcas ambiciosas</strong>. Diseñamos la estrategia multicanal perfecta para que <strong>escales posiciones y veas resultados medibles</strong>.</>
          )}
        </p>

        <!-- CTAs para Escritorio (Ocultos en Mobile) -->
        <div class="hidden md:flex md:flex-col md:items-start w-full">
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={ctaPrimaryHref}
              class="inline-flex items-center justify-center rounded-xl bg-[#ff4a09] px-6 py-3.5 text-sm font-semibold text-white shadow-md shadow-[#ff4a09]/20 transition hover:bg-[#e03e00] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[#ff4a09] focus:ring-offset-2"
            >
              {ctaPrimaryText}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>

            <a
              href={ctaSecondaryHref}
              class="inline-flex items-center justify-center px-4 py-3.5 text-sm font-semibold text-slate-800 transition hover:text-[#ff4a09]"
            >
              {ctaSecondaryText}
            </a>
          </div>

          <!-- Texto de garantía (Escritorio) -->
          <div class="mt-8 flex items-center gap-2 text-xs text-slate-500">
            <span class="h-2 w-2 rounded-full bg-[#ff4a09]"></span>
            {guaranteeText}
          </div>
        </div>

      </div>

      <!-- 2. BLOQUE DE IMAGEN / MOCKUP -->
      <div class="relative my-8 md:my-0 flex justify-center items-center w-full">
        <div class="pointer-events-none absolute h-64 w-64 rounded-full bg-[#ff4a09]/15 blur-3xl"></div>

        <div class="relative w-full max-w-md lg:max-w-lg transition-transform duration-300 hover:scale-[1.01]">
          <img
            src="/mkt6.webp"
            alt="Análisis y resultados de marketing Óros SM"
            loading="eager"
            class="w-full h-auto object-contain drop-shadow-2xl"
          />
        </div>
      </div>

      <!-- 3. CTAs Y GARANTÍA PARA MOBILE -->
      <div class="flex flex-col items-center text-center w-full md:hidden">
        <a
          href={ctaPrimaryHref}
          class="w-full inline-flex items-center justify-center rounded-xl bg-[#ff4a09] px-6 py-3.5 text-sm font-semibold text-white shadow-md shadow-[#ff4a09]/20 transition active:scale-[0.99]"
        >
          {ctaPrimaryText}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <a
          href={ctaSecondaryHref}
          class="mt-3 inline-flex items-center justify-center px-4 py-2 text-xs font-semibold text-slate-800"
        >
          {ctaSecondaryText}
        </a>

        <div class="mt-6 flex items-center justify-center gap-2 text-[11px] text-slate-500">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ff4a09]"></span>
          {guaranteeText}
        </div>
      </div>

    </div>

  </div>
</section>