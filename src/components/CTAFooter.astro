---
/**
 * CTAFooter.astro
 * - Sección de llamado a la acción final antes del pie de página.
 */

interface Service {
  title: string;
  excerpt: string;
  href: string;
  img: string;
  featured?: boolean;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  services?: Service[];
}

// Detectar idioma según la URL
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

// Textos traducidos por defecto
const defaultEyebrow = isEnglish
  ? "The only risk is standing still."
  : "El único riesgo es quedarse quieto.";

const defaultTitle = isEnglish
  ? "Let’s Build Your Next Digital Strategy."
  : "Hablemos de su próximo objetivo de crecimiento.";

const defaultDescription = isEnglish
  ? "Send us your project goals today. We’ll review your details and send a custom proposal in under 48 hours."
  : "Envíenos los detalles de su proyecto y le responderemos con una propuesta estratégica en menos de 48 horas.";

const defaultCtaText = isEnglish
  ? "Get Proposal & Pricing"
  : "Solicitar Propuesta y Tarifas";

const defaultCtaHref = isEnglish ? "/en/contact" : "/contacto";

const {
  eyebrow = defaultEyebrow,
  title = defaultTitle,
  description = defaultDescription,
  ctaText = defaultCtaText,
  ctaHref = defaultCtaHref,
} = Astro.props as Props;
---

<section class="relative px-4 py-12 md:py-16">
  <div class="mx-auto max-w-7xl">
    <!-- Banda superior con patrón sutil -->
    <div class="absolute inset-0 -z-10 rounded-t bg-[#303133]"></div>
    <div class="absolute left-0 right-0 top-0 -z-10 h-8 rounded-t-3xl [background:repeating-linear-gradient(135deg,_transparent,_transparent_10px,_rgba(255,255,255,0.06)_10px,_rgba(255,255,255,0.06)_20px)]"></div>

    <!-- Header -->
    <div class="mb-8 flex flex-col gap-4 md:mb-10 md:items-start md:justify-between">
      <div>
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-4 md:px-3 py-1 text-lg md:text-3xl font-medium text-white">
          <span class="inline-block h-4 w-4 rounded-full bg-[#ff4a09]"></span>
          {eyebrow}
        </div>

        <!-- Título principal -->
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white md:text-6xl">
          {title}
        </h2>

        <!-- Subtítulo / Descripción secundaria -->
        <p class="mt-4 text-lg md:text-2xl font-normal text-white/80 max-w-4xl">
          {description}
        </p>
      </div>

      <!-- Botón CTA -->
      <a
        href={ctaHref}
        class="group inline-flex text-xl items-center justify-center gap-2 self-start rounded-full bg-white px-4 md:px-12 py-3 text-sm font-semibold text-[#303133] hover:bg-[#FF7F50] hover:text-[#faf8f8] shadow-sm ring-1 ring-black/5 hover:shadow-md mt-4 transition-colors duration-300 group"
      >
        {ctaText}
        <svg class="size-4 -translate-x-0 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14"></path><path d="M13 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>