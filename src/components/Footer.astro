---
const {
} = Astro.props;

// Detectar idioma según la URL
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

// Definición de enlaces según el idioma
const links = {
  services: isEnglish ? "/en/services" : "/servicios",
  about: isEnglish ? "/en/about" : "/about",
  contact: isEnglish ? "/en/contact" : "/contacto",
  privacy: isEnglish ? "/en/privacy-policy" : "/privacy-policy",
};
---
<footer class="relative px-4 py-12 md:py-16 text-[#303133]">
  <!-- Contenido -->
  <div class="mx-auto max-w-7xl">
    <div class="relative grid gap-8 md:grid-cols-3">
      <!-- Columna 1 -->
      <div>
        <img src="/orossm.webp" alt="ÓROS SM Logo" class="mb-4">
        <p class="text-sm text-[#303133] leading-relaxed">
          {isEnglish 
            ? "Elevating brands through strategic marketing, design, and continuous optimization"
            : "Impulsamos tu negocio con soluciones digitales que generan impacto real."}
        </p>
      </div>

      <!-- Columna 2 -->
      <div>
        <h3 class="text-lg font-semibold mb-3 text-[#001F3F]">
          {isEnglish ? "Company" : "Enlaces"}
        </h3>
        <ul class="space-y-2 text-sm text-[#303133]">
          <li><a href={links.services} class="hover:text-[#ff4a09] transition">{isEnglish ? "Services" : "Servicios"}</a></li>
          <li><a href={links.about} class="hover:text-[#ff4a09] transition">{isEnglish ? "About Us" : "Nosotros"}</a></li>
          <li><a href={links.contact} class="hover:text-[#ff4a09] transition">{isEnglish ? "Contact" : "Contacto"}</a></li>
          <li><a href={links.privacy} class="hover:text-[#ff4a09] transition">{isEnglish ? "Privacy Policy" : "Política de Privacidad"}</a></li>
        </ul>
      </div>

      <!-- Columna 3 -->
      <div>
        <h3 class="text-lg font-semibold mb-3 text-[#001F3F]">
          {isEnglish ? "Contact" : "Contacto"}
        </h3>
        <ul class="space-y-2 text-sm text-[#303133]">
          <li><a href="tel:+5493513806166" rel="noopener noreferrer" class="hover:text-[#ff4a09] transition">+54 9 351 3806166</a></li>
          <li><a href="mailto:info@orossm.com" rel="noopener noreferrer" class="hover:text-[#ff4a09] transition">info@orossm.com</a></li>
          <li>30 N Gould St Ste R
            Sheridan, WY 82801</li>
        </ul>
      </div>
    </div>

    <!-- Línea inferior -->
    <div class="relative border-t border-black/10 mt-12 pt-6 text-sm text-center text-[#303133]">
      © 2026 OROS SM. {isEnglish ? "All rights reserved." : "Todos los derechos reservados."}.
    </div>
  </div>
</footer>