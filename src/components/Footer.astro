---
const {
} = Astro.props;

// Detectar idioma según la URL
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

// Definición de enlaces mantendidos
const links = {
  privacy: isEnglish ? "/en/privacy-policy" : "/privacy-policy",
};

// Obtener el año actual dinámicamente
const currentYear = new Date().getFullYear();
---
<footer class="relative px-4 py-12 md:py-16 text-[#303133]">
  <!-- Contenido -->
  <div class="mx-auto max-w-7xl">
    <div class="relative grid gap-8 md:grid-cols-3 items-start">
      
      <!-- Columna 1: Branding y Razón Social -->
      <div>
        <img src="/orossm.webp" alt="ÓROS SM Logo" class="mb-4">
        <h3 class="text-base font-bold text-[#001F3F] mb-1">
          Oros Strategy & Marketing LLC
        </h3>
        <p class="text-sm text-[#303133]/80 leading-relaxed">
          Serving clients nationwide across the United States.
        </p>
      </div>

      <!-- Columna 2: Contacto -->
      <div>
        <h3 class="text-lg font-semibold mb-3 text-[#001F3F]">
          {isEnglish ? "Contact" : "Contacto"}
        </h3>
        <div class="space-y-2 text-sm text-[#303133]">
          <p class="flex items-center gap-2">
            <span>✉️</span>
            <a href="mailto:info@orossm.com" rel="noopener noreferrer" class="hover:text-[#ff4a09] transition">
              info@orossm.com
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span>📞</span>
            <a href="tel:+19097453256" rel="noopener noreferrer" class="hover:text-[#ff4a09] transition">
              +1 (909) 745-3256
            </a>
          </p>
        </div>
      </div>

      <!-- Columna 3: Enlace de Política de Privacidad -->
      <div>
        <h3 class="text-lg font-semibold mb-3 text-[#001F3F]">
          {isEnglish ? "Legal" : "Legales"}
        </h3>
        <ul class="space-y-2 text-sm text-[#303133]">
          <li>
            <a href={links.privacy} class="hover:text-[#ff4a09] transition">
              {isEnglish ? "Privacy Policy" : "Política de Privacidad"}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Línea inferior de copyright -->
    <div class="relative border-t border-black/10 mt-12 pt-6 text-sm text-center text-[#303133]">
      © {currentYear} Oros SM. All rights reserved.
    </div>
  </div>
</footer>