---
// src/components/OrosServices.astro

// Detectar idioma según la URL
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

const contactHref = isEnglish ? "/en/contact" : "/contacto";

// Textos e internacionalización
const titleStart = isEnglish ? "Explore " : "Nuestros ";
const titleHighlight = isEnglish ? "Services" : "Servicios";
const subtitleText = isEnglish 
  ? "From high-converting landing pages to targeted ad management, we handle technical execution so you can run your business."
  : "Desde páginas de alta conversión hasta gestión de pautas publicitarias, nos encargamos de la ejecución técnica para que hagas crecer tu negocio.";

const ctaTitle = isEnglish 
  ? "Ready to Stop Guessing and Start Scaling?"
  : "¿Listo para dejar de adivinar y empezar a escalar?";

const ctaSubtitle = isEnglish
  ? "We will review your setup and deliver a clear action plan in under 48 hours."
  : "Analizaremos tu estructura actual y te entregaremos un plan de acción claro en menos de 48 horas.";

const ctaBtnText = isEnglish
  ? "Book Your Free Strategy Audit →"
  : "Solicitá tu Auditoría Gratuita →";
---

<main class="relative min-h-screen overflow-hidden bg-[#F4F6F8] py-12 md:py-20
  before:absolute before:inset-0 before:bg-[url('/silueta-cordillera.webp')]
  before:bg-bottom before:bg-cover before:opacity-10 before:mix-blend-multiply before:pointer-events-none">
  
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- ENCABEZADO -->
    <header class="text-center mb-12 md:mb-16">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-[#001F3F]">
        {titleStart}<span class="text-[#ff4a09]">{titleHighlight}</span>
      </h1>
      <p class="mt-4 text-xs sm:text-sm md:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        {subtitleText}
      </p>
    </header>

    <!-- LISTADO DE SERVICIOS (TARJETAS ANCHAS CON MOCKUPS) -->
    <section class="space-y-8">

      <!-- TARJETA 1: WEBSITES & LANDING PAGES -->
      <article class="group rounded-3xl border border-slate-200/80 bg-white/90 p-6 sm:p-8 md:p-10 shadow-sm backdrop-blur-md transition-all duration-300 hover:shadow-md">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <!-- Texto / Puntos clave (Columna 1-7) -->
          <div class="md:col-span-7 space-y-5">
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#001F3F]">
              {isEnglish ? "High-Converting Websites & Landing Pages" : "Sitios Web y Landings de Alta Conversión"}
            </h2>
            <ul class="space-y-3 text-xs sm:text-sm text-slate-600">
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "Custom Mobile–Optimized Landing Pages" : "Páginas de aterrizaje personalizadas y optimizadas para móviles"}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "Lead Form & CRM Integration" : "Integración directa de formularios de contacto y CRM"}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "Sub-1-Second Speed & UX Optimization" : "Velocidad de carga menor a 1 segundo y optimización UX"}</span>
              </li>
            </ul>
          </div>

          <!-- Mockup Celular Formulario (Columna 8-12) -->
          <div class="md:col-span-5 flex justify-center md:justify-end">
            <div class="w-full max-w-[240px] rounded-[28px] border-4 border-[#1E293B] bg-[#0F172A] p-3 shadow-xl">
              <div class="rounded-[20px] bg-white p-4 text-slate-900 shadow-inner">
                <p class="text-[11px] font-bold text-[#001F3F] mb-3">Get Started</p>
                <div class="space-y-2">
                  <div class="h-7 w-full rounded border border-slate-200 bg-slate-50 px-2 flex items-center text-[9px] text-slate-400">Full Name</div>
                  <div class="h-7 w-full rounded border border-slate-200 bg-slate-50 px-2 flex items-center text-[9px] text-slate-400">Email Address</div>
                  <button class="h-7 w-full rounded bg-[#ff4a09] text-[9px] font-bold text-white shadow-sm" type="button">Submit</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- TARJETA 2: PAID ADS & CAMPAIGNS -->
      <article class="group rounded-3xl border border-slate-200/80 bg-white/90 p-6 sm:p-8 md:p-10 shadow-sm backdrop-blur-md transition-all duration-300 hover:shadow-md">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <!-- Texto / Puntos clave (Columna 1-7) -->
          <div class="md:col-span-7 space-y-5">
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#001F3F]">
              {isEnglish ? "Paid Ads & Lead Generation Campaigns" : "Campañas de Anuncios y Generación de Leads"}
            </h2>
            <ul class="space-y-3 text-xs sm:text-sm text-slate-600">
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "Targeted Meta & Google Search Ads" : "Anuncios segmentados en Meta Ads y Búsqueda de Google"}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "High-Hook Direct Response Creative" : "Creativos de respuesta directa con ganchos de alto impacto"}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "Daily Budget & Audience Optimization" : "Optimización diaria de presupuesto y audiencias"}</span>
              </li>
            </ul>
          </div>

          <!-- Mockup Anuncio con Badge verde (Columna 8-12) -->
          <div class="md:col-span-5 flex justify-center md:justify-end">
            <div class="relative w-full max-w-[260px] rounded-2xl border border-slate-200 bg-white p-3 shadow-lg">
              <div class="flex items-center gap-2 mb-2">
                <div class="h-6 w-6 rounded-full bg-[#001F3F]"></div>
                <div>
                  <p class="text-[10px] font-bold text-slate-800">Active Sponsor</p>
                  <p class="text-[8px] text-slate-400">Sponsored</p>
                </div>
              </div>
              <div class="relative h-24 w-full overflow-hidden rounded-lg bg-slate-900 mb-2">
                <img src="/mkt6.webp" alt="Ad Preview" class="h-full w-full object-cover opacity-80" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                <p class="absolute bottom-2 left-2 text-[10px] font-bold text-white">Stop waiting for leads.</p>
              </div>
              <!-- Badge emergente inferior -->
              <div class="absolute -bottom-3 right-2 flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[9px] font-bold text-emerald-600 shadow-md">
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {isEnglish ? "New Lead Captured" : "Nuevo Lead Capturado"}
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- TARJETA 3: CONVERSION TRACKING & MANAGEMENT -->
      <article class="group rounded-3xl border border-slate-200/80 bg-white/90 p-6 sm:p-8 md:p-10 shadow-sm backdrop-blur-md transition-all duration-300 hover:shadow-md">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <!-- Texto / Puntos clave (Columna 1-7) -->
          <div class="md:col-span-7 space-y-5">
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#001F3F]">
              {isEnglish ? "Conversion Tracking & Ongoing Management" : "Seguimiento de Conversiones y Gestión Continua"}
            </h2>
            <ul class="space-y-3 text-xs sm:text-sm text-slate-600">
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "Server-Side Tracking (Meta CAPI & GA4)" : "Trazabilidad del lado del servidor (Meta CAPI y GA4)"}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "Transparent Metric & Revenue Dashboards" : "Tableros transparentes de métricas e ingresos"}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#ff4a09]"></span>
                <span>{isEnglish ? "Continuous A/B Testing & Retargeting" : "Pruebas A/B continuas y campañas de Remarketing"}</span>
              </li>
            </ul>
          </div>

          <!-- Mockup Dashboard ROAS (Columna 8-12) -->
          <div class="md:col-span-5 flex justify-center md:justify-end">
            <div class="w-full max-w-[260px] rounded-2xl border border-slate-200 bg-white p-4 shadow-lg">
              <div class="flex items-center justify-between text-[9px] font-bold text-slate-400 mb-1">
                <span>META ADS ROAS</span>
                <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-emerald-700">Active</span>
              </div>
              <p class="text-2xl font-extrabold text-[#001F3F]">3.84x ROAS</p>
              <p class="text-[9px] font-semibold text-emerald-500 mb-3">↑ 18.4% vs last week</p>
              <!-- Mini gráfico de curva verde -->
 <!-- Mini gráfico con ondas/puntos de inflexión idénticos a Figma -->
<svg class="h-12 w-full overflow-visible mt-2" viewBox="0 0 160 40">
  <path
    d="M 10 32 L 35 29 L 55 31 L 80 22 L 105 24 L 130 14 L 140 16 L 155 7"
    fill="none"
    stroke="#10B981"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>

            </div>
          </div>
        </div>
      </article>

    </section>

    <!-- BLOQUE INFERIOR CTA FINALES -->
    <section class="mt-12 md:mt-16 text-center">
      <div class="rounded-3xl border border-slate-200/80 bg-white/95 p-8 sm:p-12 shadow-sm backdrop-blur-md">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-[#001F3F]">
          {ctaTitle}
        </h2>
        <p class="mt-3 text-xs sm:text-sm text-slate-500 max-w-xl mx-auto">
          {ctaSubtitle}
        </p>
        <div class="mt-8 flex justify-center">
          <a
            href={contactHref}
            class="inline-flex items-center justify-center rounded-2xl bg-[#ff4a09] px-8 py-4 text-sm font-semibold text-white shadow-md shadow-[#ff4a09]/20 transition-all duration-200 hover:bg-[#e03e00] hover:shadow-lg hover:-translate-y-0.5 focus:outline-none"
          >
            {ctaBtnText}
          </a>
        </div>
      </div>
    </section>

  </div>
</main>