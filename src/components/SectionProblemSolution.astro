---
import Metrics from "./ui/Metrics.astro";
import ProgressBar from "./ui/ProgressBar.astro";

/**
 * SectionProblemSolution.astro
 * - Sección "Problem & Solution" con imágenes, textos traducibles y CTA.
 */
interface Skill {
  name: string;
  percent: number; // 0-100
}

interface Metric {
  label: string;
  value: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  skills?: Skill[];
  metrics?: Metric[];
  imgTop?: string;
  imgBottom?: string;
}

// Detectar idioma según la URL
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

// Textos traducidos según el idioma
const defaultEyebrow = isEnglish ? "About Us" : "Sobre Nosotros";

const problemLabel = isEnglish ? "The Problem" : "El Problema";
const solutionLabel = isEnglish ? "The Solution" : "La Solución";

const defaultCtaText = isEnglish ? "Let's Talk About Execution →" : "Hablemos de la Ejecución →";
const defaultCtaHref = isEnglish ? "/en/contact" : "/contacto";

const {
  eyebrow = defaultEyebrow,
  ctaText = defaultCtaText,
  ctaHref = defaultCtaHref,
  imgTop = "https://images.unsplash.com/photo-1551836022-d5d88e9218df?q=80&w=1200&auto=format&fit=crop",
  imgBottom = "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1200&auto=format&fit=crop",
} = Astro.props as Props;
---

<section class="relative mx-auto max-w-7xl px-4 py-12 md:py-16">
  <!-- Header -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">

    <!-- Columna Izquierda: Texto general -->
    <div>
      <h2 class="text-4xl md:text-5xl font-bold text-[#001F3F] mb-6">
        {isEnglish ? (
          <>Stuck Under a <span class="text-[#ff4a09]">Mountain of Pending Tasks</span>?</>
        ) : (
          <>¿Cansado de la <span class="text-[#ff4a09]">Montaña de Pendientes</span>?</>
        )}
      </h2>
      
      <p class="text-gray-600 mb-8">
        {isEnglish ? (
          "Investing time and capital into marketing without seeing a return is exhausting. Passive strategies don't work—you need a performance-driven partner who manages execution and keeps every channel working in sync"
        ) : (
          "Sabemos lo que es invertir tiempo y capital en marketing sin ver el retorno. Las estrategias pasivas no funcionan. Necesitás un socio que tome el mando de la ejecución y garantice que tus canales trabajen sincronizados."
        )}
      </p>

      <!-- Problema -->
      <div class="mb-6">
        <h3 class="text-xl font-semibold text-[#001F3F] mb-2">{problemLabel}</h3>
        <p class="text-gray-600">
          {isEnglish ? (
            <>
              You don't need more theory. <span class="font-semibold text-[#ff4a09]">You need rapid action</span>, continuous testing, and a dedicated team to run your daily digital marketing
            </>
          ) : (
            <>
              No necesitás más teoría. Necesitás <span class="font-semibold text-[#ff4a09]">acción inmediata</span>, testing constante y un equipo que resuelva la operación diaria de tu marketing digital.
            </>
          )}
        </p>
      </div>

      <!-- Solución -->
      <div class="mb-8">
        <h3 class="text-xl font-semibold text-[#001F3F] mb-2">{solutionLabel}</h3>
        <p class="text-gray-600">
          {isEnglish ? (
            <>
              We handle the <span class="font-semibold">heavy lifting</span>. From social media management and website optimization to email marketing automation, we streamline execution so you can run your business
            </>
          ) : (
            <>
              Ejecutamos la <span class="font-semibold">estrategia multicanal</span>: activamos tus redes, optimizamos tu web y automatizamos el email marketing para que vos te enfoques en el negocio.
            </>
          )}
        </p>
      </div>

      <!-- CTA -->
      <a href={ctaHref}
         class="inline-block bg-[#ff4a09] hover:bg-[#f76f3a] text-white font-medium px-6 py-3 rounded-lg transition">
         {ctaText}
      </a>
    </div>

    <!-- Columna Derecha: Imagen conceptual -->
    <div class="relative">
      <img src="/mkt4.webp"
           alt={isEnglish ? "Synchronized marketing execution" : "Ejecución de marketing sincronizada"}
           loading="lazy"
           class="rounded-xl shadow-[0_10px_30px_rgba(0,0,0,0.1)]">
    </div>

  </div>
</section>